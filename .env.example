# ============================================================
# Aether Store — the only files you edit before deploying
# Copy to .env.local for local work.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# ============================================================

# Public site
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Aether
NEXT_PUBLIC_STORE_TAGLINE=Simple tools. Fair prices. Yours in minutes.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com
NEXT_PUBLIC_OWNER_NAME=Store Owner

# Brand colors (used as CSS variables)
NEXT_PUBLIC_COLOR_INK=#1c1917
NEXT_PUBLIC_COLOR_PAPER=#f7f3ec
NEXT_PUBLIC_COLOR_ACCENT=#c45c26

# Stripe — test keys first. Switch to live keys when you go live.
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Signs the access cookie after a successful payment. Generate a long random string.
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: override default product prices (cents). Leave blank to use catalog defaults.
# PRICE_STARTER_CENTS=1900
# PRICE_OPERATOR_CENTS=4900
# PRICE_FOUNDER_CENTS=12900
# PRICE_MEMBER_MONTHLY_CENTS=900
